A2A_BASE_URL=http://8.216.45.190:8011/
A2A_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
A2A_LLM_MODEL=gpt-6.2-astra
A2A_IMAGE_MODEL=gpt-image-2.6-flare
A2A_TIMEOUT=180
A2A_MAX_REWORK=2
# HTTP A2A 的 message/send 读超时（秒）：多图网格一次 Task 里会串多张生图，默认 600
A2A_HTTP_TIMEOUT=600
# 真实截图 + 多模态视觉评审（步骤 4b），默认开
A2A_VISION_REVIEW=1
# 视觉评审问题是否升级为阻塞返修项，默认 0（只报 warning，避免主观误判无限返修）
A2A_VISION_BLOCKING=0
# 真实截图渲染引擎：libreoffice（默认）/ wps / auto
# wps 用 WPS 自带 kwpsconvert.exe ppt2pdf，需要 WPS 账号登录且有转换权限；
# 未登录会返回 exit 100 并自动回退 LibreOffice，不会让流水线失败
A2A_RENDERER=libreoffice
